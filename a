bash -c "
# 1. Purge and write a strictly verified, bulletproof Hyprland config
cat > /home/lirn/.config/caelestia/hypr-user.conf << 'HYPRUSER'
monitor=eDP-1,highres,auto,2

input {
    kb_layout = us
    natural_scroll = true
    touchpad {
        natural_scroll = true
        tap-to-click = true
        tap-and-drag = true
        drag_lock = true
        disable_while_typing = true
    }
}

misc {
    vrr = 0
    disable_hyprland_logo = true
}

$mod = SUPER

bind = $mod, Q, killactive
bind = $mod, F, fullscreen, 0
bind = $mod, M, fullscreen, 1
bind = $mod, Tab, cyclenext
bind = $mod, Space, exec, rofi -show drun
bind = $mod, Return, exec, foot
HYPRUSER

# 2. Re-enforce explicit file permissions
chown lirn:users /home/lirn/.config/caelestia/hypr-user.conf

# 3. Explicitly rebuild the Caelestia wallpaper cash to force background rendering
sudo -u lirn caelestia wallpaper -f /home/lirn/Pictures/Wallpapers/caelestia-default.png || true
sudo -u lirn caelestia scheme set -n dynamic || true

# 4. Kick the display manager to reload the session clean
sudo systemctl restart greetd.service
"
