#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# --- Configuration ---
SSID="Your_SSID"          # <-- Change this to your Wi-Fi name
PASSPHRASE="alta1234"     # <-- Your network password
INTERFACE="wlan0"         # Default interface name for wl driver

echo "==> Stopping conflicting network services..."
# Force stop iwd (iwctl) to prevent it from locking the Broadcom device
systemctl stop iwd || true

echo "==> Loading Broadcom proprietary driver (wl)..."
# Remove native modules that might conflict, then load wl
modprobe -r brcmfmac bcma b43 2>/dev/null || true
modprobe wl

echo "==> Waiting for network interface '$INTERFACE' to register..."
# Give the kernel up to 5 seconds to expose the interface
for i in {1..5}; do
    if ip link show "$INTERFACE" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

if ! ip link show "$INTERFACE" >/dev/null 2>&1; then
    echo "ERROR: Interface $INTERFACE not found after loading 'wl'."
    echo "Check 'ip link' manually to see if the interface has a different name."
    exit 1
fi

echo "==> Bringing up interface $INTERFACE..."
ip link set "$INTERFACE" up

echo "==> Generating wpa_supplicant configuration..."
mkdir -p /etc/wpa_supplicant
wpa_passphrase "$SSID" "$PASSPHRASE" > /etc/wpa_supplicant/wpa_supplicant.conf

echo "==> Starting wpa_supplicant daemon..."
# Kill any existing wpa_supplicant instances first
killall wpa_supplicant 2>/dev/null || true
wpa_supplicant -B -i "$INTERFACE" -c /etc/wpa_supplicant/wpa_supplicant.conf

echo "==> Requesting IP address via DHCP..."
# Clear previous leases and request a new one
dhcpcd -k "$INTERFACE" 2>/dev/null || true
dhcpcd "$INTERFACE"

echo "==> Verifying internet connection..."
sleep 2
if ping -c 3 archlinux.org >/dev/null 2>&1; then
    echo "SUCCESS: Connected to the internet!"
    ip addr show "$INTERFACE" | grep "inet "
else
    echo "ERROR: Dynamic IP obtained, but ping failed. Check your gateway or routing."
    exit 1
fi
