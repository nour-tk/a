bash -c "
# 1. Clear out user settings completely to eliminate the parser freeze
cat > /home/lirn/.config/caelestia/hypr-user.conf << 'HYPRUSER'
monitor=eDP-1,highres,auto,2

input {
    kb_layout = us
    natural_scroll = true
    touchpad {
        natural_scroll = true
        tap-to-click = true
    }
}

misc {
    vrr = 0
    disable_hyprland_logo = true
}
HYPRUSER

# 2. Reset permissions
chown lirn:users /home/lirn/.config/caelestia/hypr-user.conf

# 3. Explicitly copy the default wallpaper image to where Caelestia caches it
mkdir -p /home/lirn/.local/share/caelestia/wallpaper/
cp /home/lirn/Pictures/Wallpapers/caelestia-default.png /home/lirn/.local/share/caelestia/wallpaper/thumbnail.jpg
chown -R lirn:users /home/lirn/.local/share/caelestia/

# 4. Restart session manager clean
sudo systemctl restart greetd.service
"
