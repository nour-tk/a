# 1. Update the configuration to include explicit Apple SMC backlight controls
cat > ~/.config/caelestia/hypr-user.conf << 'HYPRUSER'
monitor=eDP-1,highres,auto,2

input {
    kb_layout = us
    natural_scroll = true
    touchpad {
        natural_scroll = true
        tap-to-click = true
    }
}

misc {
    vrr = 0
    disable_hyprland_logo = true
}

$mod = SUPER

# Core functional keys
bind = $mod, Q, killactive
bind = $mod, F, fullscreen, 0
bind = $mod, M, fullscreen, 1
bind = $mod, Tab, cyclenext
bind = $mod, Space, exec, rofi -show drun
bind = $mod, Return, exec, foot

# Hardware Function Keys (Optimized for your MacBook Pro hardware)
bind = , XF86MonBrightnessUp, exec, brightnessctl set +10%
bind = , XF86MonBrightnessDown, exec, brightnessctl set 10%-
bind = , XF86KbdBrightnessUp, exec, sudo brightnessctl -d "smc::kbd_backlight" set +10%
bind = , XF86KbdBrightnessDown, exec, sudo brightnessctl -d "smc::kbd_backlight" set 10%-
bind = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bind = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bind = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
HYPRUSER

# 2. Fix the Caelestia wallpaper tool engine pathing
caelestia wallpaper -f ~/Pictures/Wallpapers/caelestia-default.png
caelestia scheme set -n dynamic
